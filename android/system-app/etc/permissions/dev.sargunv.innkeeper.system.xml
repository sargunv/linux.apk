<!-- Installed as /system_ext/etc/permissions/dev.sargunv.innkeeper.system.xml. -->
<permissions>
  <!-- ro.control_privapp_permissions=enforce: every privileged permission the
       app requests must be listed here, or system_server refuses to boot. The
       platform key grants these too; the rest the app asks for are
       signature-only. -->
  <privapp-permissions package="dev.sargunv.innkeeper.system">
    <permission name="android.permission.REAL_GET_TASKS" />
    <permission name="android.permission.START_ACTIVITIES_FROM_BACKGROUND" />
    <permission name="android.permission.PACKAGE_USAGE_STATS" />
    <permission name="android.permission.INTERNAL_DELETE_CACHE_FILES" />
    <permission name="android.permission.CLEAR_APP_USER_DATA" />
    <permission name="android.permission.FORCE_STOP_PACKAGES" />
    <permission name="android.permission.GRANT_RUNTIME_PERMISSIONS" />
    <permission name="android.permission.REVOKE_RUNTIME_PERMISSIONS" />
    <permission name="android.permission.GET_RUNTIME_PERMISSIONS" />
    <!-- Desktop integration. -->
    <permission name="android.permission.CHANGE_COMPONENT_ENABLED_STATE" />
    <permission name="android.permission.CHANGE_CONFIGURATION" />
    <permission name="android.permission.MEDIA_CONTENT_CONTROL" />
    <permission name="android.permission.MODIFY_AUDIO_ROUTING" />
    <permission name="android.permission.MODIFY_DAY_NIGHT_MODE" />
    <permission name="android.permission.SET_TIME_ZONE" />
    <permission name="android.permission.WRITE_SECURE_SETTINGS" />
    <!-- Host state: location providers. -->
    <permission name="android.permission.INSTALL_LOCATION_PROVIDER" />
    <permission name="android.permission.INTERACT_ACROSS_USERS" />
    <permission name="android.permission.LOCATION_HARDWARE" />
  </privapp-permissions>

  <!-- Holders run with the "audio" group, which may enter the host bridge's socket directory
       (/dev/socket/innkeeper, root:audio 0750). -->
  <permission name="dev.sargunv.innkeeper.permission.HOST_BRIDGE">
    <group gid="audio" />
  </permission>
</permissions>
